generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id           String    @id @default(cuid())
  vapiAgent    String    @unique
  name         String
  instructions String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetings     Meeting[]

  @@map("agent")
}

enum MeetingStatus {
  UPCOMING
  COMPLETED
  ACTIVE
  PROCESSING
  CANCELED

  // Added with the Inngest migration. `meetings/details` used to be
  // client-triggered with a hardcoded 2.5s sleep and no error path, so a
  // meeting whose transcript fetch failed stayed PROCESSING forever with no
  // way to tell that apart from one still in flight.
  FAILED
}

/**
 * Shared job lifecycle for Inngest-backed work.
 *
 * Mirrors `GradeRunStatus` so every migrated flow reports progress the same
 * way. `IDLE` is the resting state for a row that owns no in-flight job.
 */
enum JobStatus {
  IDLE
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Meeting {
  id           String  @id @default(cuid())
  vapiCallId   String? @unique
  recordingURL String?

  title          String
  agentId        String
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript     String?
  callTranscript String?
  summary        String?
  chats          Chat[]
  status         MeetingStatus @default(UPCOMING)

  // Job lifecycle for the `meetings/details` Inngest function, which waits for
  // the Vapi transcript to become available and then persists it.
  jobStatus JobStatus @default(IDLE)
  jobStage  String?
  jobError  String?

  @@map("meeting")
}

enum ChatType {
  USER
  AI
}

model Chat {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  reportId  String?
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  type ChatType

  @@map("chat")
}

enum ReportType {
  COMMUNICATION
  TECHNICAL
  LEADERSHIP
  ALL
  CUSTOM
}

enum QuestionType {
  FREE_TEXT
  MULTIPLE_CHOICE
  FILL_BLANK
  TRUE_FALSE
}

model Rubric {
  id        String   @id @default(cuid())
  criteria  String
  scoring   String
  maxScore  Int
  createdAt DateTime @default(now())

  question Question?
}

model Question {
  id        String       @id @default(cuid())
  content   String
  createdAt DateTime     @default(now())
  answer    String?
  type      QuestionType
  score     Int?
  feedback  String?

  rubricId String @unique
  reportId String
  rubric   Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Report {
  id               String   @id @default(cuid())
  name             String
  createdAt        DateTime @default(now())
  score            Int?     @default(0)
  maxPossibleScore Int?     @default(0)

  breakdown String?
  summary   String?

  updatedAt DateTime   @updatedAt
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions Question[]
  chats     Chat[]

  type       ReportType
  field      String?
  customType String?

  // Job lifecycle for the two Inngest-backed flows that touch this row:
  // question generation and answer grading. Before this, completion was
  // inferred from `questions.length > 0` and `summary != null`, which cannot
  // represent "failed" at all - a report whose generation threw looked
  // identical to one that had never been started, and a partial write looked
  // complete.
  jobStatus    JobStatus @default(IDLE)
  jobStage     String?
  jobError     String?
  jobStartedAt DateTime?
  jobEndedAt   DateTime?

  @@index([userId, jobStatus])
}

model CodingProblem {
  id String @id @default(cuid())

  slug       String     @unique
  title      String
  difficulty Difficulty

  source     String?
  externalId String?

  createdAt DateTime @default(now())

  attempts CodingAttempt[]
  progress UserProblemProgress[]
  User     User?                 @relation(fields: [userId], references: [id])
  userId   String?
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model CodingAttempt {
  id String @id @default(cuid())

  userId    String
  problemId String

  language String
  code     String

  executionOutput String?
  expectedOutput  String?

  passedTests Boolean

  executionTime String?
  memoryUsage   String?

  visiblePassedCount Int?
  visibleTotalCount  Int?
  hiddenPassedCount  Int?
  hiddenTotalCount   Int?

  createdAt DateTime @default(now())

  grading CodeGrading?

  problem CodingProblem @relation(fields: [problemId], references: [id])

  // Two independent jobs can target an attempt, sequentially: run the test
  // batch, then grade the result. They are tracked with separate field sets
  // rather than one shared `jobStatus` because a single field cannot describe
  // both "tests are running" and "grading is running", and collapsing them
  // would make the client poll ambiguous.
  //
  // `testStatus` replaces an inline loop that made up to 33 sequential Judge0
  // requests inside a single HTTP request (~11 min).
  testStatus  JobStatus @default(IDLE)
  testStage   String?
  testError   String?

  // `gradeStatus` replaces an inline LLM call that had no status at all.
  // `CodeGrading` itself stays result-only and all-non-nullable, and is created
  // only once grading succeeds, so consumers of those score fields do not have
  // to handle a half-populated row.
  gradeStatus  JobStatus @default(IDLE)
  gradeStage   String?
  gradeError   String?

  @@index([userId])
  @@index([problemId])
  @@index([userId, testStatus])
  @@index([userId, gradeStatus])
}

model CodeGrading {
  id String @id @default(cuid())

  attemptId String        @unique
  attempt   CodingAttempt @relation(fields: [attemptId], references: [id])

  isCorrect   Boolean
  passedTests Boolean

  correctnessScore  Int
  efficiencyScore   Int
  codeQualityScore  Int
  bestPracticeScore Int
  totalScore        Int

  timeComplexity  String?
  spaceComplexity String?

  summary      String
  strengths    Json
  improvements Json

  createdAt DateTime @default(now())
}

model UserProblemProgress {
  id String @id @default(cuid())

  userId    String
  problemId String

  attempts  Int     @default(0)
  solved    Boolean @default(false)
  bestScore Int?

  lastAttempt DateTime?

  problem CodingProblem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
}

/**
 * One run of a candidate solution against a set of test cases.
 *
 * `/api/execute-batch` used to hold its results only in the HTTP response: it
 * made up to 33 sequential Judge0 calls inside the request and returned them
 * straight to the browser. There was no row, so nothing could poll for progress,
 * nothing survived a refresh, and a client that disconnected after two minutes
 * paid for the whole batch and got nothing back.
 *
 * A row exists so the work can be queued and the result fetched later. It is
 * deliberately *not* tied to a `CodingAttempt` - test runs and submissions are
 * separate acts, and a user can run tests many times before submitting once.
 */
model CodeExecution {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code     String
  language String

  testCases      Json
  problemContent String?
  //* When set, the batch includes model-generated hidden cases.
  generateHidden Boolean @default(false)

  jobStatus  JobStatus @default(PENDING)
  jobStage   String?
  jobError   String?
  jobEndedAt DateTime?

  //* Null until the batch finishes. Both are written in the same update so a
  //* poller can never see results without a matching summary.
  results Json?
  summary Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("code_execution")
}

enum GradeRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

model Repository {
  id String @id @default(cuid())

  githubId Int
  fullName String
  name     String
  owner    String

  description   String?
  language      String?
  defaultBranch String  @default("main")
  isFork        Boolean @default(false)
  stars         Int     @default(0)

  pushedAt     DateTime?
  lastSyncedAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  runs GradeRun[]

  @@unique([userId, githubId])
  @@index([userId])
}

model GradeRun {
  id String @id @default(cuid())

  userId       String
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  commitSha String
  status    GradeRunStatus @default(PENDING)
  stage     String?

  overallScore Int?
  letterGrade  String?
  summary      String?

  grade    Json?
  analysis Json?

  error      String?
  durationMs Int?
  llmCalls   Int     @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  findings GradeFinding[]
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, commitSha])
  @@index([userId, createdAt])
  @@index([status])
}

model GradeFinding {
  id String @id @default(cuid())

  runId String
  run   GradeRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  category String
  severity FindingSeverity @default(MEDIUM)
  title    String
  detail   String?
  fix      String?

  path String?
  line Int?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([severity])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  twoFactorEnabled       Boolean?
  emailTwoFactorEnabled  Boolean? @default(false)
  totpTwoFactorEnabled   Boolean? @default(false)
  defaultTwoFactorMethod String?

  twofactors TwoFactor[]

  passkeys Passkey[]

  stripeCustomerId String?

  sentChats       Chat[]
  createdMeetings Meeting[]
  createdAgents   Agent[]
  createdReports  Report[]
  codingProblems  CodingProblem[]
  repositories    Repository[]
  gradeRuns       GradeRun[]
  codeExecutions  CodeExecution[]

  normalizedEmail String?

  streak           Int       @default(0)
  lastStreakUpdate DateTime?

  @@unique([email])
  @@unique([normalizedEmail])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?

  aaguid String?

  @@map("passkey")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean?
  seats                Int?

  @@map("subscription")
}
